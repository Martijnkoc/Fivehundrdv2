{
  "name": "fivehundrd-wall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:reference": "node scripts/prepare-reference.mjs",
    "predev": "pnpm prepare:reference",
    "dev": "next dev",
    "prebuild": "pnpm prepare:reference",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test:e2e": "pnpm test:baseline && pnpm test:visual",
    "test:baseline": "playwright test --project=reference --update-snapshots=all",
    "test:visual": "playwright test --project=app",
    "test:db": "node --test db/schema.test.mjs",
    "test:unit": "node --import ./scripts/ts-resolve.mjs --test \"lib/**/*.test.mjs\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.9.0"
  }
}
